+
+    uint32_t warm_expected = VALUE_BASE | ((uint32_t)plane << 16) | 0x1000u;
+    uint32_t warm = dsm_load(0, runtime);
+    emit_read_val(plane, 0, warm_expected, warm, warm == warm_expected);
