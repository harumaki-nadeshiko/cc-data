+/* TC142: topology-portable skewed OLTP buffer-pool transactions. */
+#include "portable_large_workload.h"
+
+#define HOT_PAGES 32
+#define BATCHES PORTABLE_BATCHES
+#define OPS_PER_BATCH 32
