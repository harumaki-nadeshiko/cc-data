+static inline void portable_emit_results(int plane, const char *service_phase,
+                                         const char *end_to_end_phase,
+                                         const char *latency_phase,
+                                         uint32_t operations,
+                                         uint64_t service_ticks,
+                                         uint64_t end_to_end_ticks,
