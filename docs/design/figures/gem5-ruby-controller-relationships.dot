digraph RubyControllers {
  graph [
    rankdir=TB,
    splines=polyline,
    nodesep=0.42,
    ranksep=0.72,
    pad=0.52,
    margin=0.05,
    bgcolor="#f7f9fc",
    fontname="DejaVu Sans",
    fontsize=22,
    labelloc=t,
    label="Single gem5 Instance: Ruby Controller Relationships\nStrict CHI path only; one local node in split mode"
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#4f81bd",
    fillcolor="#eef5fb",
    fontcolor="#17365d",
    fontname="DejaVu Sans",
    fontsize=13,
    penwidth=1.5,
    margin="0.16,0.10"
  ];

  edge [
    color="#17365d",
    fontcolor="#34495e",
    fontname="DejaVu Sans",
    fontsize=11,
    penwidth=1.7,
    arrowsize=0.72
  ];

  subgraph cluster_gem5 {
    label="gem5 process boundary";
    labelloc=t;
    labeljust=l;
    color="#17365d";
    penwidth=2.0;
    style="rounded,filled";
    fillcolor="#ffffff";
    margin=24;

    cpu [label="CPU[k]\nper CPU (×4 by default)", fillcolor="#d9eaf7"];
    seq [label="Inst + Data\nRubySequencers", fillcolor="#d9eaf7"];
    l1 [label="CHI L1I + L1D\nControllers\n32 KiB each", fillcolor="#d9ead3", color="#57965c"];
    l2 [label="Private CHI L2\nController\n256 KiB per CPU", fillcolor="#b7dfe3", color="#168795"];
    hnf [label="HN-F[s] + L3\nHome / directory controller\none per socket", fillcolor="#d9eaf7", penwidth=2.0];

    eprnf [label="EP-RNF\nDSM endpoint cache participant\none per node", fillcolor="#fff2cc", color="#bf9000"];
    metarnf [label="Meta-RNF[s]\nmetadata requester\none per socket", fillcolor="#fff2cc", color="#bf9000"];

    lsnf [label="L-SNF\nCHI Memory Controller\none per node", fillcolor="#d9ead3", color="#57965c", group="local-memory"];
    epsnf [label="EP-SNF[s]\nDSM home-service endpoint\none per socket", fillcolor="#fce4d6", color="#c55a11", group="endpoint"];
    mem [label="Local MemCtrl\nDDR4", fillcolor="#eef5e9", color="#57965c", group="local-memory"];
    backend [label="EPBackend\nprotocol coordination\nnot a Ruby controller", fillcolor="#e8def5", color="#6b4c9a", group="endpoint"];
    adapter [label="UBAdapter[s]\none per socket", fillcolor="#e8def5", color="#6b4c9a"];

    ruby_net [
      shape=plain,
      label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#102945" BGCOLOR="#17365d">
          <TR>
            <TD PORT="l1"><FONT COLOR="white">L1</FONT></TD>
            <TD PORT="l2"><FONT COLOR="white">L2</FONT></TD>
            <TD PORT="eprnf"><FONT COLOR="white">EP-RNF</FONT></TD>
            <TD PORT="hnf"><FONT COLOR="white">HN-F</FONT></TD>
            <TD PORT="metarnf"><FONT COLOR="white">Meta-RNF</FONT></TD>
            <TD PORT="lsnf"><FONT COLOR="white">L-SNF</FONT></TD>
            <TD PORT="epsnf"><FONT COLOR="white">EP-SNF</FONT></TD>
          </TR>
          <TR>
            <TD COLSPAN="7"><FONT COLOR="white"><B>Ruby CHI Network</B></FONT></TD>
          </TR>
          <TR>
            <TD COLSPAN="7"><FONT COLOR="white">VN0 Request · VN1 Snoop · VN2 Response · VN3 Data</FONT></TD>
          </TR>
          <TR>
            <TD COLSPAN="7"><FONT COLOR="white">Every listed controller has bidirectional req / rsp / snp / dat In + Out MessageBuffers</FONT></TD>
          </TR>
        </TABLE>
      >
    ];

    { rank=same; cpu; seq; l1; l2; hnf; }
    cpu -> seq [label="CPU ports"];
    seq -> l1 [label="sequencer requests"];
    l1 -> l2 [label="L1 downstream"];
    l2 -> hnf [label="all local HN-F[s]"];

    { rank=same; eprnf; lsnf; epsnf; metarnf; }
    eprnf -> hnf [label="all local HN-F[s]"];
    metarnf -> hnf [label="same-socket HN-F"];
    hnf -> lsnf [label="local / private / metadata"];
    hnf -> epsnf [label="all DSM requests\nsame socket plane"];

    { rank=same; mem; backend; adapter; }
    lsnf -> mem [label="memory port"];
    epsnf -> backend [
      label="endpoint service",
      color="#6b4c9a",
      fontcolor="#6b4c9a",
      style=dashed
    ];
    backend -> adapter [
      label="message facade",
      color="#6b4c9a",
      fontcolor="#6b4c9a",
      style=dashed
    ];

  }

  ubio [
    label="UBIOModule / UBCC\nexternal process",
    fillcolor="#fff4ec",
    color="#c55a11",
    penwidth=1.8
  ];
  adapter -> ubio [
    label="socket-qualified Port",
    color="#6b4c9a",
    fontcolor="#6b4c9a",
    style=dashed,
    penwidth=1.8
  ];

  legend [
    shape=plain,
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#c9d3df">
        <TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="13"><B>Line</B></FONT></TD><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="13"><B>Meaning</B></FONT></TD></TR>
        <TR><TD><FONT COLOR="#17365d" POINT-SIZE="12">solid →</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">logical CHI request routing</FONT></TD></TR>
        <TR><TD><FONT COLOR="#6b4c9a" POINT-SIZE="12">dashed →</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">non-CHI backend / external binding</FONT></TD></TR>
      </TABLE>
    >
  ];
  { rank=same; legend; ubio; }
}
