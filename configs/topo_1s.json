{
  "_comment": "Single-socket topology (3 nodes, 1 socket/node). 7 processes. No barrier_manager (currently bypassed; ubio cross-forwards barriers).",
  "num_nodes": 3,
  "num_sockets": 1,
  "modules": [
    {"id": "gem5_0",  "cmd": "{gem5_bin} --outdir={node_outdir} {test_e2e} --node-id=0 --num-nodes=3 --num-sockets=1 --workload={workload}"},
    {"id": "gem5_1",  "cmd": "{gem5_bin} --outdir={node_outdir} {test_e2e} --node-id=1 --num-nodes=3 --num-sockets=1 --workload={workload}"},
    {"id": "gem5_2",  "cmd": "{gem5_bin} --outdir={node_outdir} {test_e2e} --node-id=2 --num-nodes=3 --num-sockets=1 --workload={workload}"},
    {"id": "ubio_0",  "cmd": "{ubio_bin} --node=0 --socket=0 --num-sockets=1 --num-nodes=3 {fault_rules_args}"},
    {"id": "ubio_1",  "cmd": "{ubio_bin} --node=1 --socket=0 --num-sockets=1 --num-nodes=3 {fault_rules_args}"},
    {"id": "ubio_2",  "cmd": "{ubio_bin} --node=2 --socket=0 --num-sockets=1 --num-nodes=3 {fault_rules_args}"},
