    ["gem5_1", "mem-0", "ubio_1", "mem-0"],
    ["gem5_2", "mem-0", "ubio_2", "mem-0"],
    ["ubio_0", "mem-1", "networksim", "mem-0"],
    ["ubio_1", "mem-1", "networksim", "mem-1"],
    ["ubio_2", "mem-1", "networksim", "mem-2"]
  ]
