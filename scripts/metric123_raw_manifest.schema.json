{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metric123_raw_manifest.schema.json",
  "title": "Metric1/2/3 explicit raw-log manifest",
  "type": "object",
  "required": ["schema_version", "runs"],
  "properties": {
    "schema_version": {"const": 1},
    "correctness_policy": {"enum": ["strict", "required", "optional"]},
    "requirements": {
      "type": "object",
      "properties": {
        "metric1": {
          "type": "object",
          "properties": {
            "repetitions": {"type": "array", "items": {"type": ["string", "integer"]}, "uniqueItems": true},
            "min_samples": {"type": "integer", "minimum": 1},
            "roles": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true,
              "default": ["naive", "spill", "ideal"]
            },
            "ideal_min_capacity": {"type": "integer", "minimum": 1, "default": 102656}
          }
        },
        "metric2": {
          "type": "object",
          "properties": {
            "repetitions": {"type": "array", "items": {"type": ["string", "integer"]}, "uniqueItems": true},
            "min_samples": {"type": "integer", "minimum": 1},
            "testcases": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true}
          }
        },
        "metric3": {
          "type": "object",
          "properties": {
            "mode": {"enum": ["independent", "paired"], "default": "independent"},
            "repetitions": {"type": "array", "items": {"type": ["string", "integer"]}, "uniqueItems": true},
            "min_repetitions": {"type": "integer", "minimum": 1},
            "min_samples": {"type": "integer", "minimum": 1},
            "testcases": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
            "arms": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true,
              "default": ["ourcc", "ha-vi"]
            },
            "pairs": {"type": "array", "items": {"type": ["string", "integer"]}, "uniqueItems": true}
          }
        },
        "qualification_sets": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object", "required": ["id", "metric", "coordinates"],
                "properties": {
                  "id": {"type": "string", "minLength": 1}, "metric": {"const": 1},
                  "coordinates": {"type": "array", "minItems": 1, "items": {
                    "type": "object", "required": ["tc", "topology", "home_node", "home_socket"],
                    "properties": {"tc": {"type": "integer"}, "topology": {"type": "string", "pattern": "^[0-9]+n[0-9]+s$"}, "home_node": {"type": "integer", "minimum": 0}, "home_socket": {"type": "integer", "minimum": 0}}
                  }},
                  "repetitions": {"type": "array", "minItems": 1, "items": {"type": ["string", "integer"]}, "uniqueItems": true},
                  "min_samples": {"type": "integer", "minimum": 1},
                  "ideal_min_capacity": {"type": "integer", "minimum": 1},
                  "thresholds": {"type": "object", "properties": {"capacity_ratio_min": {"type": "number"}, "outer_delta_cycles_strict_max": {"type": "number"}, "cycles_per_ns": {"type": "number"}}}
                }
              },
              {
                "type": "object", "required": ["id", "metric", "coordinates"],
                "properties": {
                  "id": {"type": "string", "minLength": 1}, "metric": {"const": 2},
                  "coordinates": {"type": "array", "minItems": 1, "items": {
                    "type": "object", "required": ["tc", "topology", "phase"],
                    "oneOf": [
                      {"required": ["expected_node", "expected_samples"]},
                      {"required": ["expected_nodes", "expected_count"]}
                    ],
                    "properties": {"tc": {"type": "integer"}, "topology": {"type": "string", "pattern": "^[0-9]+n[0-9]+s$"}, "phase": {"type": "string", "minLength": 1}, "kind": {"enum": ["timer", "latency"]}, "reduction": {"enum": ["aggregate", "max"]}, "expected_node": {"type": "integer", "minimum": 0}, "expected_samples": {"type": "integer", "minimum": 1}, "expected_nodes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true}, "expected_count": {"type": "integer", "minimum": 1}}
                  }},
                  "repetitions": {"type": "array", "minItems": 1, "items": {"type": ["string", "integer"]}, "uniqueItems": true},
                  "min_samples": {"type": "integer", "minimum": 1},
                  "profiles": {"type": "array", "items": {"enum": ["naive", "spill", "spill-noopt", "optimized"]}, "uniqueItems": true},
                  "baseline_profile": {"enum": ["naive", "spill", "spill-noopt", "optimized"]}, "result_profile": {"enum": ["naive", "spill", "spill-noopt", "optimized"]},
                  "thresholds": {"type": "object", "properties": {"baseline_applicable_min_ns": {"type": "number"}, "reduction_pct_min": {"type": "number"}}}
                }
              },
              {
                "type": "object", "required": ["id", "metric", "mode", "topologies", "testcases"],
                "allOf": [
                  {"if": {"properties": {"mode": {"const": "paired"}}}, "then": {"required": ["pairs"]}},
                  {"if": {"properties": {"mode": {"const": "independent"}}}, "then": {}}
                ],
                "properties": {
                  "id": {"type": "string", "minLength": 1}, "metric": {"const": 3}, "mode": {"enum": ["paired", "independent"]},
                  "topologies": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9]+n[0-9]+s$"}, "uniqueItems": true},
                  "testcases": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 228, "maximum": 235}, "uniqueItems": true},
                  "arms": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"enum": ["ourcc", "ubcc", "lossless-oneway", "ha-vi", "havi", "ha_vi"]}, "uniqueItems": true},
                  "pairs": {"type": "array", "minItems": 1, "items": {"type": ["string", "integer"]}, "uniqueItems": true},
                  "repetitions": {"type": "array", "minItems": 1, "items": {"type": ["string", "integer"]}, "uniqueItems": true}, "min_repetitions": {"type": "integer", "minimum": 1}, "min_samples": {"type": "integer", "minimum": 1},
                  "thresholds": {"type": "object", "properties": {"delta_ticks_strict_min": {"type": "number", "deprecated": true, "description": "Accepted for compatibility but not enforced; Metric3 reports both delta directions."}}}
                }
              }
            ]
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "tc", "topology", "simulator_log_dir", "simout_dir"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "metric": {"enum": [1, 2, 3]},
          "tc": {"type": "integer"},
          "repetition": {"type": ["string", "integer"]},
          "topology": {"type": "string", "pattern": "^[0-9]+n[0-9]+s$"},
          "simulator_log_dir": {"type": "string"},
          "simout_dir": {"type": "string"},
          "profile": {"enum": ["naive", "spill", "spill-noopt", "optimized", "ideal", "ideal-dir", "infinite"]},
          "metric1_role": {"type": "string", "minLength": 1},
          "arm": {"type": "string", "minLength": 1},
          "pair": {"type": ["string", "integer"]},
          "order": {"enum": ["AB", "BA"]},
          "home_node": {"type": "integer", "minimum": 0},
          "home_socket": {"type": "integer", "minimum": 0},
          "home_ubio_log_dir": {"type": "string"},
          "home_ubio_logs": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "timer_nodes": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
          "phase": {"type": "string", "minLength": 1},
          "expected_node": {"type": "integer", "minimum": 0},
          "expected_samples": {"type": "integer", "minimum": 1},
          "metric_specs": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["kind", "phase", "reduction"],
              "properties": {
                "kind": {"enum": ["timer", "latency"]},
                "phase": {"type": "string", "minLength": 1},
                "reduction": {"enum": ["aggregate", "max"]}
              }
            }
          }
        }
      }
    }
  }
}
