{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metric123_raw_manifest.schema.json",
  "title": "Metric1/2/3 explicit raw-log manifest",
  "type": "object",
  "required": ["schema_version", "runs"],
  "properties": {
    "schema_version": {"const": 1},
    "correctness_policy": {"enum": ["strict", "required", "optional"]},
    "requirements": {
      "type": "object",
      "properties": {
        "metric1": {
          "type": "object",
          "properties": {
            "repetitions": {"type": "array", "items": {"type": ["string", "integer"]}, "uniqueItems": true},
            "roles": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true,
              "default": ["naive", "spill", "ideal"]
            },
            "ideal_min_capacity": {"type": "integer", "minimum": 1, "default": 102656}
          }
        },
        "metric3": {
          "type": "object",
          "properties": {
            "mode": {"enum": ["independent", "paired"], "default": "independent"},
            "repetitions": {"type": "array", "items": {"type": ["string", "integer"]}, "uniqueItems": true},
            "min_repetitions": {"type": "integer", "minimum": 1},
            "testcases": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
            "arms": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true,
              "default": ["ourcc", "ha-vi"]
            },
            "pairs": {"type": "array", "items": {"type": ["string", "integer"]}, "uniqueItems": true}
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "tc", "repetition", "topology", "simulator_log_dir", "simout_dir"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "metric": {"enum": [1, 2, 3]},
          "tc": {"type": "integer"},
          "repetition": {"type": ["string", "integer"]},
          "topology": {"type": "string", "pattern": "^[0-9]+n[0-9]+s$"},
          "simulator_log_dir": {"type": "string"},
          "simout_dir": {"type": "string"},
          "profile": {"enum": ["naive", "spill", "spill-noopt", "optimized"]},
          "metric1_role": {"type": "string", "minLength": 1},
          "arm": {"type": "string", "minLength": 1},
          "pair": {"type": ["string", "integer"]},
          "order": {"enum": ["AB", "BA"]},
          "home_node": {"type": "integer", "minimum": 0},
          "home_socket": {"type": "integer", "minimum": 0},
          "home_ubio_log_dir": {"type": "string"},
          "home_ubio_logs": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "timer_nodes": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
          "phase": {"type": "string", "minLength": 1},
          "expected_node": {"type": "integer", "minimum": 0},
          "expected_samples": {"type": "integer", "minimum": 1},
          "metric_specs": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["kind", "phase", "reduction"],
              "properties": {
                "kind": {"enum": ["timer", "latency"]},
                "phase": {"type": "string", "minLength": 1},
                "reduction": {"enum": ["aggregate", "max"]}
              }
            }
          }
        }
      }
    }
  }
}
